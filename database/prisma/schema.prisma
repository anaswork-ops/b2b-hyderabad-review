generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationRole {
  BUSINESS_USER
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum BusinessStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REQUEST_INFORMATION
  REJECTED
  SUSPENDED
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  MOBILE_VERIFICATION
  MFA_LOGIN
}

model User {
  id                 String                @id @default(uuid()) @db.Uuid
  email              String                @unique @db.VarChar(320)
  passwordHash       String                @map("password_hash") @db.VarChar(255)
  role               ApplicationRole       @default(BUSINESS_USER)
  status             AccountStatus         @default(ACTIVE)
  emailVerifiedAt    DateTime?             @map("email_verified_at")
  mobile             String?               @unique @db.VarChar(32)
  mobileVerifiedAt   DateTime?             @map("mobile_verified_at")
  mfaSecretEncrypted String?               @map("mfa_secret_encrypted") @db.Text
  mfaEnabledAt       DateTime?             @map("mfa_enabled_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  businesses         Business[]
  sessions           Session[]
  tokens             IdentityToken[]
  applications       BusinessApplication[]
  reviews            ApplicationReview[]

  @@map("users")
}

model Business {
  id                       String                    @id @default(uuid()) @db.Uuid
  primaryOwnerId           String                    @map("primary_owner_id") @db.Uuid
  status                   BusinessStatus            @default(DRAFT)
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  primaryOwner             User                      @relation(fields: [primaryOwnerId], references: [id], onDelete: Restrict)
  application              BusinessApplication?
  profile                  BusinessProfile?
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]
  initiatedCustomRequests  CustomPackageRequest[]    @relation("requester")
  receivedCustomRequests   CustomPackageRequest[]    @relation("provider")
  blocksCreated            BusinessBlock[]           @relation("blocker")
  blocksReceived           BusinessBlock[]           @relation("blocked")
  conversationReports      ConversationReport[]

  @@index([primaryOwnerId, status])
  @@map("businesses")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  csrfHash  String    @map("csrf_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model IdentityToken {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  purpose    TokenPurpose
  tokenHash  String       @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime     @map("expires_at")
  consumedAt DateTime?    @map("consumed_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("identity_tokens")
}

model AuditEvent {
  resourceId String?  @map("resource_id") @db.Uuid
  reason     String?  @db.VarChar(2000)
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80)
  resource   String   @db.VarChar(80)
  outcome    String   @db.VarChar(32)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([resourceId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

model NotificationIntent {
  id               String    @id @default(uuid()) @db.Uuid
  recipientUserId  String    @map("recipient_user_id") @db.Uuid
  kind             String    @db.VarChar(48)
  payloadEncrypted String    @map("payload_encrypted") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  deliveredAt      DateTime? @map("delivered_at")
  channel          String    @default("EMAIL") @db.VarChar(16)
  deliveryState    String    @default("PENDING") @map("delivery_state") @db.VarChar(16)
  attempts         Int       @default(0)
  lastError        String?   @map("last_error") @db.VarChar(100)

  @@index([recipientUserId, createdAt])
  @@map("notification_intents")
}

enum BusinessType {
  TRAVEL_AGENCY
  TOUR_OPERATOR
  DMC
}

enum ApplicationDocumentKind {
  REGISTRATION_LICENCE
  SUPPORTING
}

model BusinessApplication {
  id                String                @id @default(uuid()) @db.Uuid
  businessId        String                @unique @map("business_id") @db.Uuid
  ownerId           String                @unique @map("owner_id") @db.Uuid
  status            BusinessStatus        @default(DRAFT)
  legalName         String?               @map("legal_name") @db.VarChar(200)
  tradingName       String?               @map("trading_name") @db.VarChar(200)
  businessType      BusinessType?         @map("business_type")
  address           String?               @db.VarChar(500)
  country           String?               @db.VarChar(100)
  state             String?               @db.VarChar(100)
  city              String?               @db.VarChar(100)
  contactEmail      String?               @map("contact_email") @db.VarChar(320)
  contactMobile     String?               @map("contact_mobile") @db.VarChar(32)
  website           String?               @db.VarChar(500)
  yearsOperating    Int?                  @map("years_operating")
  capabilities      String[]              @default([])
  sourceMarkets     String[]              @default([]) @map("source_markets")
  saudiDestinations String[]              @default([]) @map("saudi_destinations")
  licenceNumber     String?               @map("licence_number") @db.VarChar(120)
  licenceIssuer     String?               @map("licence_issuer") @db.VarChar(200)
  submittedAt       DateTime?             @map("submitted_at")
  reviewedAt        DateTime?             @map("reviewed_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  business          Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  owner             User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  documents         ApplicationDocument[]
  reviews           ApplicationReview[]

  @@index([status, submittedAt])
  @@index([ownerId, createdAt])
  @@map("business_applications")
}

model DocumentRequirement {
  id           String                  @id @default(uuid()) @db.Uuid
  market       String                  @db.VarChar(100)
  businessType BusinessType            @map("business_type")
  kind         ApplicationDocumentKind
  required     Boolean                 @default(true)
  enabled      Boolean                 @default(true)

  @@unique([market, businessType, kind])
  @@map("document_requirements")
}

model ApplicationDocument {
  id            String                  @id @default(uuid()) @db.Uuid
  applicationId String                  @map("application_id") @db.Uuid
  kind          ApplicationDocumentKind
  storageKey    String                  @unique @map("storage_key") @db.VarChar(200)
  filename      String                  @db.VarChar(200)
  contentType   String                  @map("content_type") @db.VarChar(100)
  sizeBytes     Int                     @map("size_bytes")
  createdAt     DateTime                @default(now()) @map("created_at")
  application   BusinessApplication     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, kind])
  @@map("application_documents")
}

model ApplicationReview {
  id            String              @id @default(uuid()) @db.Uuid
  applicationId String              @map("application_id") @db.Uuid
  actorId       String              @map("actor_id") @db.Uuid
  fromStatus    BusinessStatus      @map("from_status")
  toStatus      BusinessStatus      @map("to_status")
  note          String?             @db.VarChar(2000)
  createdAt     DateTime            @default(now()) @map("created_at")
  application   BusinessApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  actor         User                @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@map("application_reviews")
}

enum OfferingStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum PilgrimageSubtype {
  HAJJ
  UMRAH
}

enum ServiceVertical {
  TOURISM
  HAJJ_UMRAH
  VISA_SERVICES
}

enum PricingMode {
  FIXED
  STARTING_FROM
  ON_REQUEST
}

enum AvailabilityKind {
  FIXED_DEPARTURE
  DATE_RANGE
  RECURRING
  YEAR_ROUND
  ON_REQUEST
}

model BusinessProfile {
  id                  String            @id @default(uuid()) @db.Uuid
  businessId          String            @unique @map("business_id") @db.Uuid
  publicSlug          String            @unique @map("public_slug") @db.VarChar(120)
  name                String            @db.VarChar(200)
  businessType        BusinessType      @map("business_type")
  description         String            @db.VarChar(3000)
  logoKey             String?           @map("logo_key") @db.VarChar(200)
  headquartersCountry String            @map("headquarters_country") @db.VarChar(100)
  headquartersState   String            @map("headquarters_state") @db.VarChar(100)
  headquartersCity    String            @map("headquarters_city") @db.VarChar(100)
  publicEmail         String?           @map("public_email") @db.VarChar(320)
  publicPhone         String?           @map("public_phone") @db.VarChar(32)
  privateEmail        String            @map("private_email") @db.VarChar(320)
  privatePhone        String            @map("private_phone") @db.VarChar(32)
  website             String?           @db.VarChar(500)
  yearsOperating      Int               @map("years_operating")
  languages           String[]          @default([])
  marketsServed       String[]          @default([]) @map("markets_served")
  capabilities        String[]          @default([])
  serviceCountries    String[]          @default([]) @map("service_countries")
  serviceCities       String[]          @default([]) @map("service_cities")
  licenceNumber       String?           @map("licence_number") @db.VarChar(120)
  licenceIssuer       String?           @map("licence_issuer") @db.VarChar(200)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  business            Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  packages            Package[]
  services            Service[]
  offers              Offer[]
  legacyOffers        Offer[]           @relation("legacyOfferProfile")
  verticals           ServiceVertical[] @default([HAJJ_UMRAH])
  tourismPackages     TourismPackage[]
  visaServices        VisaService[]

  @@index([businessType, headquartersCountry])
  @@map("business_profiles")
}

model Package {
  moderationHidden  Boolean            @default(false) @map("moderation_hidden")
  id                String             @id @default(uuid()) @db.Uuid
  profileId         String             @map("profile_id") @db.Uuid
  name              String             @db.VarChar(200)
  subtype           PilgrimageSubtype
  status            OfferingStatus     @default(DRAFT)
  sourceMarket      String             @map("source_market") @db.VarChar(100)
  departureCity     String             @map("departure_city") @db.VarChar(100)
  destinationCities String[]           @map("destination_cities")
  validFrom         DateTime?          @map("valid_from") @db.Date
  validTo           DateTime?          @map("valid_to") @db.Date
  totalNights       Int                @map("total_nights")
  makkahNights      Int                @map("makkah_nights")
  madinahNights     Int                @map("madinah_nights")
  minimumGroupSize  Int?               @map("minimum_group_size")
  maximumGroupSize  Int?               @map("maximum_group_size")
  accommodation     Json
  roomOccupancy     String[]           @map("room_occupancy")
  transport         Json
  flights           Json?
  meals             String[]
  visaStatus        String             @map("visa_status") @db.VarChar(80)
  ziyarat           String[]
  assistance        String[]
  inclusions        String[]
  exclusions        String[]
  pricingMode       PricingMode        @map("pricing_mode")
  price             Decimal?           @db.Decimal(14, 2)
  currency          String?            @db.Char(3)
  cancellationTerms String             @map("cancellation_terms") @db.VarChar(3000)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  publishedAt       DateTime?          @map("published_at")
  profile           BusinessProfile    @relation(fields: [profileId], references: [id], onDelete: Restrict)
  availability      AvailabilityRule[]
  media             OfferingMedia[]
  offers            Offer[]

  @@index([profileId, status, updatedAt])
  @@index([subtype, sourceMarket, status])
  @@map("packages")
}

model Service {
  moderationHidden Boolean            @default(false) @map("moderation_hidden")
  id               String             @id @default(uuid()) @db.Uuid
  profileId        String             @map("profile_id") @db.Uuid
  name             String             @db.VarChar(200)
  subtype          PilgrimageSubtype
  status           OfferingStatus     @default(DRAFT)
  description      String             @db.VarChar(3000)
  sourceMarket     String             @map("source_market") @db.VarChar(100)
  serviceCountry   String             @map("service_country") @db.VarChar(100)
  serviceCity      String             @map("service_city") @db.VarChar(100)
  pricingMode      PricingMode        @map("pricing_mode")
  price            Decimal?           @db.Decimal(14, 2)
  currency         String?            @db.Char(3)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  profile          BusinessProfile    @relation(fields: [profileId], references: [id], onDelete: Restrict)
  availability     AvailabilityRule[]
  media            OfferingMedia[]
  offers           Offer[]

  @@index([profileId, status, updatedAt])
  @@map("services")
}

model Offer {
  moderationHidden Boolean          @default(false) @map("moderation_hidden")
  id               String           @id @default(uuid()) @db.Uuid
  profileId        String           @map("profile_id") @db.Uuid
  packageId        String?          @map("package_id") @db.Uuid
  serviceId        String?          @map("service_id") @db.Uuid
  title            String           @db.VarChar(200)
  description      String           @db.VarChar(2000)
  validFrom        DateTime         @map("valid_from") @db.Date
  validTo          DateTime         @map("valid_to") @db.Date
  pricingMode      PricingMode      @map("pricing_mode")
  price            Decimal?         @db.Decimal(14, 2)
  currency         String?          @db.Char(3)
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  package          Package?         @relation(fields: [packageId], references: [id], onDelete: Restrict)
  service          Service?         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  profile          BusinessProfile  @relation(fields: [profileId], references: [id], onDelete: Restrict)
  legacyProfile    BusinessProfile? @relation("legacyOfferProfile", fields: [legacyProfileId], references: [id])
  legacyProfileId  String?          @map("businessProfileId") @db.Uuid

  @@index([profileId, active, validTo])
  @@map("offers")
}

model TourismPackage {
  moderationHidden   Boolean            @default(false) @map("moderation_hidden")
  id                 String             @id @default(uuid()) @db.Uuid
  profileId          String             @map("profile_id") @db.Uuid
  name               String             @db.VarChar(200)
  description        String             @db.VarChar(3000)
  status             OfferingStatus     @default(DRAFT)
  sourceMarket       String             @map("source_market") @db.VarChar(100)
  departureCity      String             @map("departure_city") @db.VarChar(100)
  destinationCountry String             @map("destination_country") @db.VarChar(100)
  destinationCities  String[]           @map("destination_cities")
  category           String             @db.VarChar(100)
  durationDays       Int                @map("duration_days")
  minimumGroupSize   Int?               @map("minimum_group_size")
  maximumGroupSize   Int?               @map("maximum_group_size")
  accommodation      String             @db.VarChar(1000)
  transport          String             @db.VarChar(1000)
  inclusions         String[]
  exclusions         String[]
  pricingMode        PricingMode        @map("pricing_mode")
  price              Decimal?           @db.Decimal(14, 2)
  currency           String?            @db.Char(3)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  publishedAt        DateTime?          @map("published_at")
  profile            BusinessProfile    @relation(fields: [profileId], references: [id], onDelete: Restrict)
  availability       AvailabilityRule[]

  @@index([profileId, status, updatedAt])
  @@index([status, sourceMarket, destinationCountry, category, price])
  @@map("tourism_packages")
}

model VisaService {
  moderationHidden      Boolean            @default(false) @map("moderation_hidden")
  id                    String             @id @default(uuid()) @db.Uuid
  profileId             String             @map("profile_id") @db.Uuid
  name                  String             @db.VarChar(200)
  description           String             @db.VarChar(3000)
  status                OfferingStatus     @default(DRAFT)
  sourceMarket          String             @map("source_market") @db.VarChar(100)
  applicantNationality  String             @map("applicant_nationality") @db.VarChar(100)
  destinationCountry    String             @map("destination_country") @db.VarChar(100)
  visaCategory          String             @map("visa_category") @db.VarChar(100)
  processingRequirement String             @map("processing_requirement") @db.VarChar(1000)
  documentSummary       String             @map("document_summary") @db.VarChar(2000)
  appointmentAssistance Boolean            @default(false) @map("appointment_assistance")
  governmentFeeIncluded Boolean            @default(false) @map("government_fee_included")
  pricingMode           PricingMode        @map("pricing_mode")
  price                 Decimal?           @db.Decimal(14, 2)
  currency              String?            @db.Char(3)
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  publishedAt           DateTime?          @map("published_at")
  profile               BusinessProfile    @relation(fields: [profileId], references: [id], onDelete: Restrict)
  availability          AvailabilityRule[]

  @@index([profileId, status, updatedAt])
  @@index([status, sourceMarket, destinationCountry, visaCategory, price])
  @@map("visa_services")
}

enum ConversationContextType {
  BUSINESS
  PACKAGE
  SERVICE
  OFFER
  CUSTOM_REQUEST
  TOURISM_PACKAGE
  VISA_SERVICE
}

enum CustomRequestStatus {
  OPEN
  RESPONDED
  CLOSED
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model Conversation {
  id                String                    @id @default(uuid()) @db.Uuid
  contextType       ConversationContextType   @map("context_type")
  contextBusinessId String?                   @map("context_business_id") @db.Uuid
  contextPackageId  String?                   @map("context_package_id") @db.Uuid
  contextServiceId  String?                   @map("context_service_id") @db.Uuid
  contextOfferId    String?                   @map("context_offer_id") @db.Uuid
  contextTourismId  String?                   @map("context_tourism_id") @db.Uuid
  contextVisaId     String?                   @map("context_visa_id") @db.Uuid
  customRequestId   String?                   @unique @map("custom_request_id") @db.Uuid
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  lastMessageAt     DateTime?                 @map("last_message_at")
  participants      ConversationParticipant[]
  messages          Message[]
  customRequest     CustomPackageRequest?     @relation(fields: [customRequestId], references: [id], onDelete: Restrict)
  reports           ConversationReport[]

  @@index([lastMessageAt, createdAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String       @map("conversation_id") @db.Uuid
  businessId     String       @map("business_id") @db.Uuid
  lastReadAt     DateTime?    @map("last_read_at")
  joinedAt       DateTime     @default(now()) @map("joined_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@id([conversationId, businessId])
  @@index([businessId, lastReadAt])
  @@map("conversation_participants")
}

model Message {
  id               String              @id @default(uuid()) @db.Uuid
  conversationId   String              @map("conversation_id") @db.Uuid
  senderBusinessId String              @map("sender_business_id") @db.Uuid
  body             String              @db.VarChar(4000)
  createdAt        DateTime            @default(now()) @map("created_at")
  conversation     Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderBusiness   Business            @relation(fields: [senderBusinessId], references: [id], onDelete: Restrict)
  attachments      MessageAttachment[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  messageId   String   @map("message_id") @db.Uuid
  storageKey  String   @unique @map("storage_key") @db.VarChar(200)
  filename    String   @db.VarChar(120)
  contentType String   @map("content_type") @db.VarChar(100)
  sizeBytes   Int      @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at")
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
  @@map("message_attachments")
}

model BusinessBlock {
  blockerBusinessId String   @map("blocker_business_id") @db.Uuid
  blockedBusinessId String   @map("blocked_business_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  blockerBusiness   Business @relation("blocker", fields: [blockerBusinessId], references: [id], onDelete: Cascade)
  blockedBusiness   Business @relation("blocked", fields: [blockedBusinessId], references: [id], onDelete: Cascade)

  @@id([blockerBusinessId, blockedBusinessId])
  @@map("business_blocks")
}

model ConversationReport {
  id                 String       @id @default(uuid()) @db.Uuid
  conversationId     String       @map("conversation_id") @db.Uuid
  reporterBusinessId String       @map("reporter_business_id") @db.Uuid
  reason             String       @db.VarChar(1000)
  status             ReportStatus @default(OPEN)
  createdAt          DateTime     @default(now()) @map("created_at")
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reporterBusiness   Business     @relation(fields: [reporterBusinessId], references: [id], onDelete: Restrict)

  @@unique([conversationId, reporterBusinessId])
  @@index([status, createdAt])
  @@map("conversation_reports")
}

model CustomPackageRequest {
  id                  String              @id @default(uuid()) @db.Uuid
  requesterBusinessId String              @map("requester_business_id") @db.Uuid
  providerBusinessId  String              @map("provider_business_id") @db.Uuid
  subtype             PilgrimageSubtype
  departureCity       String              @map("departure_city") @db.VarChar(100)
  startDate           DateTime            @map("start_date") @db.Date
  endDate             DateTime            @map("end_date") @db.Date
  groupSize           Int                 @map("group_size")
  totalNights         Int                 @map("total_nights")
  makkahNights        Int                 @map("makkah_nights")
  madinahNights       Int                 @map("madinah_nights")
  requirements        String              @db.VarChar(4000)
  status              CustomRequestStatus @default(OPEN)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  requesterBusiness   Business            @relation("requester", fields: [requesterBusinessId], references: [id], onDelete: Restrict)
  providerBusiness    Business            @relation("provider", fields: [providerBusinessId], references: [id], onDelete: Restrict)
  conversation        Conversation?

  @@index([requesterBusinessId, createdAt])
  @@index([providerBusinessId, status, createdAt])
  @@map("custom_package_requests")
}

model AvailabilityRule {
  id               String           @id @default(uuid()) @db.Uuid
  packageId        String?          @map("package_id") @db.Uuid
  serviceId        String?          @map("service_id") @db.Uuid
  tourismPackageId String?          @map("tourism_package_id") @db.Uuid
  visaServiceId    String?          @map("visa_service_id") @db.Uuid
  kind             AvailabilityKind
  startDate        DateTime?        @map("start_date") @db.Date
  endDate          DateTime?        @map("end_date") @db.Date
  recurrence       String?          @db.VarChar(120)
  blackoutDates    DateTime[]       @map("blackout_dates") @db.Date
  capacity         Int?
  createdAt        DateTime         @default(now()) @map("created_at")
  package          Package?         @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service          Service?         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tourismPackage   TourismPackage?  @relation(fields: [tourismPackageId], references: [id], onDelete: Cascade)
  visaService      VisaService?     @relation(fields: [visaServiceId], references: [id], onDelete: Cascade)

  @@index([packageId, startDate, endDate])
  @@index([serviceId, startDate, endDate])
  @@index([tourismPackageId, startDate, endDate])
  @@index([visaServiceId, startDate, endDate])
  @@map("availability_rules")
}

model OfferingMedia {
  id          String   @id @default(uuid()) @db.Uuid
  packageId   String?  @map("package_id") @db.Uuid
  serviceId   String?  @map("service_id") @db.Uuid
  kind        String   @db.VarChar(16)
  storageKey  String   @unique @map("storage_key") @db.VarChar(200)
  filename    String   @db.VarChar(200)
  contentType String   @map("content_type") @db.VarChar(100)
  sizeBytes   Int      @map("size_bytes")
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  package     Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([packageId, createdAt])
  @@index([serviceId, createdAt])
  @@map("offering_media")
}
