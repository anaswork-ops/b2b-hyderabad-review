{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"],
      "env": ["NEXT_PUBLIC_API_ORIGIN", "API_PROXY_ORIGIN", "API_ORIGIN"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "S3_ENDPOINT",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "WEB_ORIGIN",
    "API_ORIGIN",
    "API_PORT",
    "AUTH_ENCRYPTION_KEY",
    "NEXT_PUBLIC_API_ORIGIN",
    "S3_BUCKET",
    "S3_REGION",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "GLOBAL_RATE_LIMIT_MAX",
    "TRUSTED_PROXY_CIDRS",
    "OTEL_SERVICE_NAME",
    "EMAIL_DELIVERY_URL",
    "EMAIL_DELIVERY_KEY",
    "MOBILE_DELIVERY_URL",
    "MOBILE_DELIVERY_KEY",
    "API_PROXY_ORIGIN"
  ]
}
