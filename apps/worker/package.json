{
  "name": "@b2b/worker",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run --exclude **/*.integration.test.ts --passWithNoTests",
    "test:integration": "vitest run test/notification.integration.test.ts"
  },
  "dependencies": {
    "@b2b/contracts": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "6.3.6",
    "ioredis": "^5.0.0",
    "pg": "8.17.2",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.16.0",
    "eslint": "10.10.0",
    "tsx": "^4.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "type": "module"
}
