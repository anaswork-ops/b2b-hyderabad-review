{
  "name": "@b2b/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run --exclude **/*.integration.test.ts --passWithNoTests",
    "test:integration": "vitest run test/auth.integration.test.ts test/applications.integration.test.ts test/inventory.integration.test.ts test/marketplace.integration.test.ts test/messaging.integration.test.ts test/verticals.integration.test.ts test/admin.integration.test.ts",
    "dev:staff": "node --env-file=../../.env node_modules/tsx/dist/cli.mjs src/dev-staff.ts",
    "dev:inbox": "node --env-file=../../.env node_modules/tsx/dist/cli.mjs src/dev-inbox.ts",
    "demo:seed": "node --env-file=../../.env node_modules/tsx/dist/cli.mjs src/demo-seed.ts",
    "demo:verify": "node --env-file=../../.env node_modules/tsx/dist/cli.mjs src/demo-verify.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1134.0",
    "@b2b/contracts": "workspace:*",
    "@b2b/notifications": "workspace:*",
    "@b2b/validation": "workspace:*",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.0.0",
    "@vercel/queue": "0.7.0",
    "argon2": "^0.45.1",
    "bullmq": "6.3.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.0.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "redis": "6.2.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "10.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "type": "module"
}
