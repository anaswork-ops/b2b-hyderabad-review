# Local development only. Set values in ignored .env files; never commit credentials.
NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
GLOBAL_RATE_LIMIT_MAX=120
# Comma-separated CIDRs of trusted ingress only; leave empty for direct connections.
TRUSTED_PROXY_CIDRS=
# Set a unique service name per API/worker deployment.
OTEL_SERVICE_NAME=b2b-api
LOCAL_DB_USER=LOCAL_USER
LOCAL_DB_PASSWORD=LOCAL_PASSWORD
DATABASE_URL=postgresql://LOCAL_USER:LOCAL_PASSWORD@127.0.0.1:55432/b2btravelv2_dev
REDIS_URL=redis://127.0.0.1:16380
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=local-development
S3_ACCESS_KEY_ID=LOCAL_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=LOCAL_SECRET_ACCESS_KEY
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Generate a unique 32-byte hex key per environment; never commit its value.
AUTH_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001

# External notification gateways must implement docs/operations/NOTIFICATIONS.md.
# Leave empty for the protected demo. Never use real delivery credentials there.
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_KEY=
MOBILE_DELIVERY_URL=
MOBILE_DELIVERY_KEY=

# Required in production; Prometheus uses the matching protected token file.
METRICS_TOKEN=

# Hosted review only; leave local defaults unchanged.
DEPLOYMENT_MODE=
STORAGE_DRIVER=s3
NEXT_PUBLIC_STORAGE_DRIVER=s3
# Vercel supplies the private Blob store ID after connecting the project.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Hosted recovery endpoint requires an independent secret of at least 32 characters.
CRON_SECRET=
