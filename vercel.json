{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "cd ../.. && pnpm exec turbo run build --filter=@b2b/web",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_ORIGIN"
        }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "entrypoint": "server.mjs",
      "buildCommand": "cd ../.. && pnpm db:generate && pnpm exec turbo run build --filter=@b2b/api",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
      "functions": {
        "server.mjs": {
          "includeFiles": "{package.json,dist/package.json}"
        }
      }
    },
    "notifications": {
      "root": "apps/worker",
      "entrypoint": "server.mjs",
      "buildCommand": "cd ../.. && pnpm db:generate && pnpm exec turbo run build --filter=@b2b/worker",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
      "functions": {
        "server.mjs": {
          "maxDuration": 30,
          "experimentalTriggers": [
            {
              "type": "queue/v2beta",
              "topic": "notifications",
              "retryAfterSeconds": 30,
              "maxDeliveries": 5
            }
          ],
          "includeFiles": "{package.json,dist/package.json}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/internal/outbox",
      "schedule": "0 3 * * *"
    }
  ],
  "regions": [
    "sin1"
  ]
}
